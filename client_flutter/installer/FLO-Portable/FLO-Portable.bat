@echo off
title FL? - Portable Mode
color 0B
cls

echo.
echo ?????????????????????????????????????????????
echo ?         FL? - Portable Edition           ?
echo ?         Teams. Unified.                   ?
echo ?????????????????????????????????????????????
echo.
echo Starting FL? in portable mode...
echo.
echo Data Location: %~dp0data
echo.

REM Set portable mode environment variables
set FLO_PORTABLE=1
set FLO_DATA_DIR=%~dp0data
