generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
}

model VaultEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
}

model NodeRegistry {
  id        String   @id @default(cuid())
  nodeId    String   @unique
  address   String
  createdAt DateTime @default(now())
}

model ProofLog {
  id        String   @id @default(cuid())
  phase     String
  message   String
  timestamp DateTime @default(now())
}

model ChatThread {
  id        String        @id @default(uuid())
  title     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id         String     @id @default(uuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id])
  senderId   String
  senderName String
  content    String
  createdAt  DateTime   @default(now())
}
